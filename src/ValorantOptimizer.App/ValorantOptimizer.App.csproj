<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ValorantOptimizer.App</RootNamespace>
    <AssemblyName>ValorantOptimizer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ValorantOptimizer.Core\ValorantOptimizer.Core.csproj" />
    <ProjectReference Include="..\ValorantOptimizer.Diagnostics\ValorantOptimizer.Diagnostics.csproj" />
    <ProjectReference Include="..\ValorantOptimizer.Optimizations\ValorantOptimizer.Optimizations.csproj" />
  </ItemGroup>
</Project>
