<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window -->
    <Color x:Key="Color.Bg.Window">#0B0D12</Color>
    <Color x:Key="Color.Bg.Sidebar">#0E1117</Color>
    <Color x:Key="Color.Bg.Surface">#12161F</Color>
    <Color x:Key="Color.Bg.SurfaceRaised">#171C26</Color>
    <Color x:Key="Color.Bg.SurfaceHover">#1E2431</Color>
    <Color x:Key="Color.Bg.Input">#10141C</Color>

    <!-- Lines -->
    <Color x:Key="Color.Border.Subtle">#1D2431</Color>
    <Color x:Key="Color.Border.Default">#262E3D</Color>
    <Color x:Key="Color.Border.Strong">#374153</Color>
    <Color x:Key="Color.Border.Window">#2A3242</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#F3F5F9</Color>
    <Color x:Key="Color.Text.Secondary">#A8B2C3</Color>
    <Color x:Key="Color.Text.Muted">#6D788B</Color>
    <Color x:Key="Color.Text.Inverse">#0B0D12</Color>

    <!-- Brand -->
    <Color x:Key="Color.Accent.Default">#FF4655</Color>
    <Color x:Key="Color.Accent.Hover">#FF5C69</Color>
    <Color x:Key="Color.Accent.Pressed">#E63A48</Color>
    <Color x:Key="Color.Accent.Soft">#2A1419</Color>
    <Color x:Key="Color.Accent.Border">#5A2630</Color>

    <!-- Semantic -->
    <Color x:Key="Color.Success">#46D69A</Color>
    <Color x:Key="Color.Success.Soft">#102C22</Color>
    <Color x:Key="Color.Success.Border">#1F5A44</Color>

    <Color x:Key="Color.Warning">#F4B860</Color>
    <Color x:Key="Color.Warning.Soft">#2E2413</Color>
    <Color x:Key="Color.Warning.Border">#5C4822</Color>

    <Color x:Key="Color.Danger">#FF6572</Color>
    <Color x:Key="Color.Danger.Soft">#2E151A</Color>
    <Color x:Key="Color.Danger.Border">#5C2630</Color>

    <Color x:Key="Color.Info">#6FA8FF</Color>
    <Color x:Key="Color.Info.Soft">#142033</Color>

    <Color x:Key="Color.Neutral">#8C96A8</Color>
    <Color x:Key="Color.Neutral.Soft">#1B202B</Color>

    <!-- Category accents -->
    <Color x:Key="Color.Category.Memory">#B38CFF</Color>
    <Color x:Key="Color.Category.Memory.Soft">#221A33</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Bg.Window" Color="{StaticResource Color.Bg.Window}" />
    <SolidColorBrush x:Key="Bg.Sidebar" Color="{StaticResource Color.Bg.Sidebar}" />
    <SolidColorBrush x:Key="Bg.Surface" Color="{StaticResource Color.Bg.Surface}" />
    <SolidColorBrush x:Key="Bg.SurfaceRaised" Color="{StaticResource Color.Bg.SurfaceRaised}" />
    <SolidColorBrush x:Key="Bg.SurfaceHover" Color="{StaticResource Color.Bg.SurfaceHover}" />
    <SolidColorBrush x:Key="Bg.Input" Color="{StaticResource Color.Bg.Input}" />

    <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Border.Window" Color="{StaticResource Color.Border.Window}" />

    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Text.Inverse" Color="{StaticResource Color.Text.Inverse}" />
    <SolidColorBrush x:Key="Text.White" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Accent.Default" Color="{StaticResource Color.Accent.Default}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Accent.Soft" Color="{StaticResource Color.Accent.Soft}" />
    <SolidColorBrush x:Key="Accent.Border" Color="{StaticResource Color.Accent.Border}" />

    <SolidColorBrush x:Key="State.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="State.SuccessSoft" Color="{StaticResource Color.Success.Soft}" />
    <SolidColorBrush x:Key="State.SuccessBorder" Color="{StaticResource Color.Success.Border}" />
    <SolidColorBrush x:Key="State.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="State.WarningSoft" Color="{StaticResource Color.Warning.Soft}" />
    <SolidColorBrush x:Key="State.WarningBorder" Color="{StaticResource Color.Warning.Border}" />
    <SolidColorBrush x:Key="State.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="State.DangerSoft" Color="{StaticResource Color.Danger.Soft}" />
    <SolidColorBrush x:Key="State.DangerBorder" Color="{StaticResource Color.Danger.Border}" />
    <SolidColorBrush x:Key="State.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="State.InfoSoft" Color="{StaticResource Color.Info.Soft}" />
    <SolidColorBrush x:Key="State.Neutral" Color="{StaticResource Color.Neutral}" />
    <SolidColorBrush x:Key="State.NeutralSoft" Color="{StaticResource Color.Neutral.Soft}" />

    <SolidColorBrush x:Key="Category.Memory" Color="{StaticResource Color.Category.Memory}" />
    <SolidColorBrush x:Key="Category.Memory.Soft" Color="{StaticResource Color.Category.Memory.Soft}" />

    <SolidColorBrush x:Key="Scrim" Color="#A6000000" />
    <SolidColorBrush x:Key="Transparent" Color="Transparent" />

    <!-- Effects -->
    <DropShadowEffect x:Key="Effect.CardShadow" Color="#000000" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.35" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Effect.DrawerShadow" Color="#000000" BlurRadius="32" ShadowDepth="0" Direction="0" Opacity="0.5" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Effect.ToastShadow" Color="#000000" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" RenderingBias="Performance" />

</ResourceDictionary>
