<Window x:Class="ValorantOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ValorantOptimizer.App.Views"
        Title="VALORANT Optimization Toolkit"
        Width="1320"
        Height="860"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Bg.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="NavItemTemplate">
            <Button Style="{StaticResource Button.Nav}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Title}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{Binding Icon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.4"
                          Width="15"
                          Height="15"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    <Border Grid.Column="2"
                            Background="{StaticResource Bg.SurfaceHover}"
                            CornerRadius="9"
                            Padding="7,2"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding CountText}"
                                   FontSize="10"
                                   Foreground="{StaticResource Text.Secondary}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Boot overlay motion: one settle technique, exits accelerate away. -->
        <Storyboard x:Key="BootIntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="BootOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.12" FillBehavior="Stop" />

            <DoubleAnimation Storyboard.TargetName="BootMarkScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.9" To="1" Duration="0:0:0.38" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BootMarkScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.9" To="1" Duration="0:0:0.38" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BootMarkGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.26" FillBehavior="Stop" />

            <DoubleAnimation Storyboard.TargetName="BootWordmarkGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.18" Duration="0:0:0.22" FillBehavior="Stop" />
            <DoubleAnimation Storyboard.TargetName="BootWordmarkShift"
                             Storyboard.TargetProperty="Y"
                             From="8" To="0" BeginTime="0:0:0.18" Duration="0:0:0.30" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="BootProgressRail"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.30" Duration="0:0:0.20" FillBehavior="Stop" />
            <DoubleAnimation Storyboard.TargetName="BootStatusText"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.42" Duration="0:0:0.20" FillBehavior="Stop" />
        </Storyboard>

        <Storyboard x:Key="BootProgressLoop">
            <DoubleAnimation Storyboard.TargetName="BootProgressSweep"
                             Storyboard.TargetProperty="X"
                             From="-90" To="260"
                             Duration="0:0:1.15"
                             RepeatBehavior="Forever"
                             FillBehavior="Stop" />
        </Storyboard>

        <Storyboard x:Key="BootExitStoryboard">
            <DoubleAnimation Storyboard.TargetName="BootOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.25" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="{StaticResource Bg.Window}"
            BorderBrush="{StaticResource Border.Window}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= Title bar ================= -->
            <Grid Grid.Row="0"
                  Background="{StaticResource Bg.Sidebar}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Grid Width="24" Height="24" Margin="0,0,10,0">
                        <Ellipse Width="17" Height="17"
                                 Stroke="{StaticResource Accent.Default}"
                                 StrokeThickness="1.6"
                                 Opacity="0.95" />
                        <Rectangle Width="4" Height="4" Fill="{StaticResource Accent.Default}" />
                        <Rectangle Width="24" Height="1.2" Fill="{StaticResource Accent.Default}" Opacity="0.55" />
                        <Rectangle Width="1.2" Height="24" Fill="{StaticResource Accent.Default}" Opacity="0.55" />
                    </Grid>
                    <TextBlock Text="VALORANT" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="/" FontSize="12" Foreground="{StaticResource Text.Muted}" Margin="7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Optimization Toolkit"
                               FontSize="12"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource Accent.Soft}"
                            BorderBrush="{StaticResource Accent.Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5,1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="BETA" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource Accent.Default}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <Border Background="{StaticResource State.WarningSoft}"
                            BorderBrush="{StaticResource State.WarningBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="PREVIEW DATA"
                                   FontSize="8.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource State.Warning}" />
                    </Border>
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="10.5"
                               Foreground="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.TitleBar}"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize"
                            Click="MinimizeButton_Click">
                        <TextBlock Text="&#xE921;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource Button.TitleBar}"
                            ToolTip="Maximize" AutomationProperties.Name="Maximize"
                            Click="MaximizeButton_Click">
                        <TextBlock x:Name="MaximizeGlyph"
                                   Text="&#xE922;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                    <Button Style="{StaticResource Button.TitleBarClose}"
                            ToolTip="Close" AutomationProperties.Name="Close"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Content ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource Bg.Sidebar}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,1,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,16">
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6"
                                         Fill="{Binding EnvironmentBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EnvironmentLabel}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastScannedLabel}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="13,3,0,0" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Padding="0"
                                    Margin="0,10,0,0"
                                    Command="{Binding OpenDataFolderCommand}"
                                    ToolTip="{Binding DataFolderPath}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,6 H10 L12,9 H21 V19 H3 Z"
                                          Stroke="{StaticResource Text.Muted}"
                                          StrokeThickness="1.3"
                                          Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Text="Open data folder"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding AppliedCountLabel}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding RiotDisclaimer}"
                                       Style="{StaticResource Text.Caption}"
                                       FontSize="9.5"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Opacity="0.8" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,12,0,0"
                                      Focusable="False">
                            <StackPanel>
                                <TextBlock Text="OPTIMIZATIONS"
                                           Style="{StaticResource Text.SectionLabel}"
                                           Margin="22,8,0,8" />
                                <ItemsControl ItemsSource="{Binding OverviewNav}"
                                              ItemTemplate="{StaticResource NavItemTemplate}"
                                              Focusable="False" />
                                <TextBlock Text="TOOLKIT"
                                           Style="{StaticResource Text.SectionLabel}"
                                           Margin="22,20,0,8" />
                                <ItemsControl ItemsSource="{Binding ToolNav}"
                                              ItemTemplate="{StaticResource NavItemTemplate}"
                                              Focusable="False" />
                                <Border Height="16" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Active page -->
                <Grid Grid.Column="1" Margin="28,22,28,0">
                    <views:OverviewView Visibility="{Binding IsOptimizationPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:MonitoringView Visibility="{Binding IsMonitoringPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:StartupView Visibility="{Binding IsStartupPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:HistoryView Visibility="{Binding IsHistoryPage, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>

            <!-- ================= Overlays ================= -->
            <views:DetailDrawer Grid.RowSpan="2" Panel.ZIndex="10" />
            <views:ConfirmDialog Grid.RowSpan="2" Panel.ZIndex="20" />
            <views:ToastView Grid.RowSpan="2" Panel.ZIndex="30" />

            <!-- ================= Boot overlay ================= -->
            <Grid x:Name="BootOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="40"
                  Background="{StaticResource Bg.Window}"
                  Visibility="Visible"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Crosshair mark, matching the title bar and app icon. -->
                    <Grid x:Name="BootMarkGroup"
                          Width="96" Height="96"
                          HorizontalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="BootMarkScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Ellipse Width="70" Height="70"
                                 Stroke="{StaticResource Accent.Default}"
                                 StrokeThickness="4" />
                        <Ellipse Width="9" Height="9"
                                 Fill="{StaticResource Accent.Default}" />
                        <Rectangle Width="4" Height="13"
                                   Fill="{StaticResource Accent.Default}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <Rectangle Width="4" Height="13"
                                   Fill="{StaticResource Accent.Default}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        <Rectangle Width="13" Height="4"
                                   Fill="{StaticResource Accent.Default}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Rectangle Width="13" Height="4"
                                   Fill="{StaticResource Accent.Default}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel x:Name="BootWordmarkGroup"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,22,0,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="BootWordmarkShift" X="0" Y="0" />
                        </StackPanel.RenderTransform>
                        <TextBlock Text="VALORANT"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}" />
                        <TextBlock Text="/"
                                   FontSize="15" Margin="7,0"
                                   Foreground="{StaticResource Text.Muted}" />
                        <TextBlock Text="Optimization Toolkit"
                                   FontSize="15"
                                   Foreground="{StaticResource Text.Secondary}" />
                    </StackPanel>

                    <Border x:Name="BootProgressRail"
                            Width="260" Height="3" Margin="0,26,0,0"
                            Background="{StaticResource Bg.SurfaceRaised}"
                            CornerRadius="1.5"
                            ClipToBounds="True">
                        <Border x:Name="BootProgressBar"
                                Width="90" Height="3"
                                HorizontalAlignment="Left"
                                Background="{StaticResource Accent.Default}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="BootProgressSweep" X="-90" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <TextBlock x:Name="BootStatusText"
                               Text="Preparing system scan"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
