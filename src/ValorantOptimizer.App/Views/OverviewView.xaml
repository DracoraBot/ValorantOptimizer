<UserControl x:Class="ValorantOptimizer.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ValorantOptimizer.App.ViewModels"
             d:DesignHeight="800"
             d:DesignWidth="1000"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="SummaryTileTemplate">
            <Border Style="{StaticResource Panel.Tile}"
                    Width="148"
                    Height="76"
                    Margin="0,0,8,10"
                    ToolTip="{Binding Tooltip}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5"
                                 Fill="{Binding Accent}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Label}"
                                   Style="{StaticResource Text.SectionLabel}"
                                   FontSize="9.5" />
                    </StackPanel>
                    <TextBlock Text="{Binding Value}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SubValue}"
                               Style="{StaticResource Text.Caption}"
                               FontSize="10.5"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate">
            <Border Width="312"
                    Height="252"
                    Margin="0,0,16,16"
                    Cursor="Hand"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.Card}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Category + risk -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32"
                                CornerRadius="9"
                                Background="{Binding CategorySoft}">
                            <Path Data="{Binding CategoryIcon}"
                                  Stroke="{Binding CategoryAccent}"
                                  StrokeThickness="1.5"
                                  Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CategoryLabel}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RiskLabel}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{Binding RiskForeground}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Name}"
                               Style="{StaticResource Text.CardTitle}"
                               TextWrapping="Wrap"
                               MaxHeight="42"
                               Margin="0,11,0,0" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding Summary}"
                               Style="{StaticResource Text.Body}"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               MaxHeight="36"
                               Margin="0,6,0,0" />

                    <!-- State -->
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6"
                                 Fill="{Binding StateForeground}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Headline}"
                                   FontSize="11"
                                   Foreground="{Binding StateForeground}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Headline}" />
                    </Grid>

                    <Border Grid.Row="5" Style="{StaticResource Divider}" Margin="0,10,0,0" />

                    <!-- Footer -->
                    <Grid Grid.Row="6" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding MetaLabel}"
                                   Style="{StaticResource Text.Caption}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,8,0" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowIdleActions, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Undo" AutomationProperties.Name="Undo change"
                                    Style="{StaticResource Button.Outline}"
                                    FontSize="11"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding ShowUndo, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.RequestUndoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Apply" AutomationProperties.Name="Apply change"
                                    Style="{StaticResource Button.Primary}"
                                    FontSize="11"
                                    Padding="12,4"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding ShowApply, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.RequestApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}" />
                            <Border Background="{StaticResource State.NeutralSoft}"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowUnavailable, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding UnavailableLabel}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource State.Neutral}" />
                            </Border>
                            <Button Style="{StaticResource Button.Icon}"
                                    Width="24"
                                    Height="24"
                                    ToolTip="Details" AutomationProperties.Name="Show details"
                                    Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}">
                                <Path Data="M9,5 L16,12 L9,19"
                                      Stroke="{StaticResource Text.Secondary}"
                                      StrokeThickness="1.6"
                                      Width="6"
                                      Height="10"
                                      Stretch="Uniform"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding BusyText}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource State.Info}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="0,0,8,0">

            <!-- Page header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageEyebrow}" Style="{StaticResource Text.SectionLabel}" />
                    <TextBlock Text="{Binding PageTitle}"
                               Style="{StaticResource Text.PageTitle}"
                               Margin="0,5,0,0" />
                    <TextBlock Text="{Binding PageSubtitle}"
                               Style="{StaticResource Text.Subtitle}"
                               TextWrapping="Wrap"
                               MaxWidth="720"
                               HorizontalAlignment="Left"
                               Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="20,4,0,0">
                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding ApplySafeCommand}" AutomationProperties.Name="Apply safe recommendations"
                            Visibility="{Binding HasSafeRecommendations, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SafeRecommendationLabel}" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}"
                            Margin="10,0,0,0"
                            Command="{Binding RescanCommand}" AutomationProperties.Name="Rescan"
                            ToolTip="Re-read Windows, hardware and VALORANT state">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Rescan" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Scan progress -->
            <Border Style="{StaticResource Panel.Tile}"
                    Background="{StaticResource State.InfoSoft}"
                    BorderBrush="{StaticResource Border.Default}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource State.Info}"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="{Binding ScanStatus}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Scan error -->
            <Border Style="{StaticResource Panel.Tile}"
                    Background="{StaticResource State.DangerSoft}"
                    BorderBrush="{StaticResource State.DangerBorder}"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasScanError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource State.Danger}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScanError}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource State.Danger}"
                               Margin="9,0,0,0"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- System summary -->
            <ItemsControl ItemsSource="{Binding SummaryTiles}"
                          ItemTemplate="{StaticResource SummaryTileTemplate}"
                          Focusable="False"
                          Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Filters -->
            <Grid Margin="0,10,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl ItemsSource="{Binding StateFilters}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Chip}"
                                    Content="{Binding Label}"
                                    Command="{Binding SelectCommand}"
                                    Margin="0,0,8,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Column="1" Width="248" Margin="12,0">
                    <TextBox Style="{StaticResource TextBox.Search}"
                             Tag="Search optimizations…"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search optimizations" />
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource Text.Muted}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <TextBlock Grid.Column="2"
                           Text="{Binding VisibleCountLabel}"
                           Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Cards -->
            <Grid>
                <ItemsControl ItemsSource="{Binding CardsView}"
                              ItemTemplate="{StaticResource CardTemplate}"
                              Focusable="False"
                              Margin="0,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Style="{StaticResource Panel.Tile}"
                        Width="560"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Padding="28"
                        Margin="0,0,0,16"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding EmptyMessage}"
                                   Style="{StaticResource Text.BodyStrong}"
                                   FontSize="14"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="Clear the search or choose another category in the sidebar."
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="No FPS gain is promised. Each card is a specific, reversible configuration change with a captured rollback — not a benchmark result."
                       Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,24"
                       MaxWidth="820"
                       HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
