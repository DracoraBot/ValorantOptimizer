<UserControl x:Class="ValorantOptimizer.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="800"
             d:DesignWidth="1000"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="StartupRowTemplate">
            <Border BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,0,1"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32"
                                CornerRadius="9"
                                Background="{Binding AvatarBackground}"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding Initial}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AvatarForeground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Background="{StaticResource State.WarningSoft}"
                                        BorderBrush="{StaticResource State.WarningBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasFlags, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding FlagsLabel}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource State.Warning}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Command}"
                                       Style="{StaticResource Text.Mono}"
                                       FontSize="10"
                                       Foreground="{StaticResource Text.Muted}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Command}"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Note}"
                                       Style="{StaticResource Text.Caption}"
                                       FontSize="10"
                                       Foreground="{StaticResource State.Warning}"
                                       TextWrapping="Wrap"
                                       MaxWidth="430"
                                       Margin="0,5,0,0"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Publisher}"
                               Style="{StaticResource Text.Caption}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top"
                               Margin="0,4,18,0" />

                    <Border Grid.Column="2"
                            Background="{StaticResource Bg.Surface}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,2,18,0">
                        <TextBlock Text="{Binding SourceLabel}"
                                   FontSize="10"
                                   Foreground="{StaticResource Text.Secondary}" />
                    </Border>

                    <Border Grid.Column="3"
                            Background="{Binding EnabledSoft}"
                            CornerRadius="20"
                            Padding="9,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5"
                                     Fill="{Binding EnabledForeground}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0" />
                            <TextBlock Text="{Binding EnabledLabel}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding EnabledForeground}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="0,0,8,0">

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageEyebrow}" Style="{StaticResource Text.SectionLabel}" />
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.PageTitle}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding PageSubtitle}"
                               Style="{StaticResource Text.Subtitle}"
                               TextWrapping="Wrap"
                               MaxWidth="760"
                               HorizontalAlignment="Left"
                               Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,4,0,0">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding RefreshStartupCommand}" AutomationProperties.Name="Refresh startup apps">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Primary}" Margin="10,0,0,0" Command="{Binding OpenTaskManagerCommand}" AutomationProperties.Name="Open Task Manager">
                        <TextBlock Text="Open Task Manager" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Review-only banner -->
            <Border Style="{StaticResource Panel.Tile}"
                    Background="{StaticResource State.InfoSoft}"
                    BorderBrush="{StaticResource Border.Default}"
                    Padding="16,13"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="M12,3 L20,6.5 V12 C20,17 16.5,20.5 12,21.5 C7.5,20.5 4,17 4,12 V6.5 Z"
                          Stroke="{StaticResource State.Info}"
                          StrokeThickness="1.5"
                          Width="17"
                          Height="18"
                          Stretch="Uniform"
                          VerticalAlignment="Top"
                          Margin="0,1,0,0"
                          StrokeLineJoin="Round" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Review only — this screen never changes anything."
                                   Style="{StaticResource Text.BodyStrong}"
                                   FontSize="12.5" />
                        <TextBlock Text="Each entry is shown with its command line, publisher and source so you can decide what belongs on your PC. Disabling is left to Windows Task Manager, which keeps its own restore path. Entries flagged “Anti-cheat” or “Do not disable” must be left alone."
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status / loading -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="{Binding StartupSummary}"
                           Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Reading startup entries…"
                           Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsStartupLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Border Style="{StaticResource Panel.Tile}"
                    Background="{StaticResource State.DangerSoft}"
                    BorderBrush="{StaticResource State.DangerBorder}"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasStartupError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StartupError}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource State.Danger}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Table -->
            <Border Style="{StaticResource Panel.Card}" Padding="0" Margin="0,0,0,20">
                <StackPanel>
                    <Border Background="{StaticResource Bg.Surface}"
                            CornerRadius="14,14,0,0"
                            Padding="14,10"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="APPLICATION"
                                       Style="{StaticResource Text.SectionLabel}"
                                       FontSize="9.5" />
                            <TextBlock Grid.Column="1"
                                       Text="PUBLISHER"
                                       Style="{StaticResource Text.SectionLabel}"
                                       FontSize="9.5" />
                            <TextBlock Grid.Column="2"
                                       Text="SOURCE"
                                       Style="{StaticResource Text.SectionLabel}"
                                       FontSize="9.5" />
                            <TextBlock Grid.Column="3"
                                       Text="STATE"
                                       Style="{StaticResource Text.SectionLabel}"
                                       FontSize="9.5" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding StartupApps}"
                                  ItemTemplate="{StaticResource StartupRowTemplate}"
                                  Focusable="False"
                                  Visibility="{Binding HasStartupApps, Converter={StaticResource BoolToVisibility}}" />

                    <Border Padding="28"
                            Visibility="{Binding ShowStartupEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="&#xE768;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{StaticResource Text.Muted}" />
                            <TextBlock Text="No startup applications found"
                                       Style="{StaticResource Text.BodyStrong}"
                                       FontSize="13.5"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="Nothing is registered in the Run keys or Startup folders for this user."
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="VALORANT requires Riot Vanguard. The toolkit never disables anti-cheat, security, audio or GPU services, and will flag them for review instead."
                       Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap"
                       MaxWidth="820"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
