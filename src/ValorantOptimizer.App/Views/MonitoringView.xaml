<UserControl x:Class="ValorantOptimizer.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="800"
             d:DesignWidth="1000"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ProcessRowTemplate">
            <Border BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,0,1"
                    Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource Text.Body}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MemoryText}"
                               Style="{StaticResource Text.Mono}"
                               FontSize="11"
                               Foreground="{StaticResource Text.Secondary}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="UnavailableTileTemplate">
            <Border Style="{StaticResource Panel.Card}"
                    Opacity="0.6"
                    Padding="14,12"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.SectionLabel}" FontSize="9.5" />
                    <TextBlock Text="{Binding Value}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,7,0,0" />
                    <TextBlock Text="{Binding Detail}"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="0,0,8,0">

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageEyebrow}" Style="{StaticResource Text.SectionLabel}" />
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.PageTitle}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding PageSubtitle}"
                               Style="{StaticResource Text.Subtitle}"
                               TextWrapping="Wrap"
                               MaxWidth="760"
                               HorizontalAlignment="Left"
                               Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,4,0,0">
                    <Button Style="{StaticResource Button.Secondary}"
                            Command="{Binding Monitoring.ToggleCommand}"
                            Content="{Binding Monitoring.ToggleButtonText}"
                            AutomationProperties.Name="Toggle live sampling" />
                </StackPanel>
            </Grid>

            <!-- Live status -->
            <Border Style="{StaticResource Panel.Tile}"
                    Background="{StaticResource Bg.Surface}"
                    Padding="14,9"
                    Margin="0,0,0,14">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6"
                                 Fill="{Binding Monitoring.StatusBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Monitoring.StatusText}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{Binding Monitoring.StatusBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Read-only local sampling every second"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Monitoring.LastSampleText}"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel.Tile}"
                    Background="{StaticResource State.DangerSoft}"
                    BorderBrush="{StaticResource State.DangerBorder}"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    Visibility="{Binding Monitoring.HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Monitoring.ErrorText}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource State.Danger}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Live metric tiles -->
            <UniformGrid Columns="4" Margin="0,0,-12,4">
                <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="CPU UTILIZATION" Style="{StaticResource Text.SectionLabel}" FontSize="9" />
                        <TextBlock Text="{Binding Monitoring.CpuText}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="System-wide · all processes"
                                   Style="{StaticResource Text.Caption}"
                                   FontSize="10"
                                   Margin="0,3,0,0" />
                        <Polyline Points="{Binding Monitoring.CpuSparkline}"
                                  Stroke="{StaticResource State.Success}"
                                  StrokeThickness="1.5"
                                  Height="34"
                                  Margin="0,8,0,0"
                                  Stretch="Fill"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel.Card}"
                        Padding="14,12"
                        Margin="0,0,12,12"
                        Opacity="{Binding Monitoring.GpuTileOpacity}">
                    <StackPanel>
                        <TextBlock Text="GPU UTILIZATION" Style="{StaticResource Text.SectionLabel}" FontSize="9" />
                        <TextBlock Text="{Binding Monitoring.GpuText}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Monitoring.GpuNameText}"
                                   Style="{StaticResource Text.Caption}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                        <Polyline Points="{Binding Monitoring.GpuSparkline}"
                                  Stroke="{StaticResource Accent.Default}"
                                  StrokeThickness="1.5"
                                  Height="34"
                                  Margin="0,8,0,0"
                                  Stretch="Fill"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource Text.SectionLabel}" FontSize="9" />
                        <TextBlock Text="{Binding Monitoring.MemoryText}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Monitoring.MemoryDetail}"
                                   Style="{StaticResource Text.Caption}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                        <Polyline Points="{Binding Monitoring.MemorySparkline}"
                                  Stroke="{StaticResource State.Info}"
                                  StrokeThickness="1.5"
                                  Height="34"
                                  Margin="0,8,0,0"
                                  Stretch="Fill"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel.Card}"
                        Padding="14,12"
                        Margin="0,0,12,12"
                        Opacity="{Binding Monitoring.GpuTempTileOpacity}">
                    <StackPanel>
                        <TextBlock Text="GPU TEMPERATURE" Style="{StaticResource Text.SectionLabel}" FontSize="9" />
                        <TextBlock Text="{Binding Monitoring.GpuTempText}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Monitoring.GpuTempDetail}"
                                   Style="{StaticResource Text.Caption}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Monitoring gaps + RAM consumers -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel.Card}" Padding="16,14" Margin="0,0,14,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Background RAM usage"
                                       Style="{StaticResource Text.BodyStrong}"
                                       FontSize="12.5" />
                            <TextBlock Text="Top processes by working set"
                                       Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Read-only snapshot. Closing processes is left to Task Manager — background services can restart or break features."
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,4" />
                        <ItemsControl ItemsSource="{Binding Monitoring.TopProcesses}"
                                      ItemTemplate="{StaticResource ProcessRowTemplate}"
                                      Focusable="False" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="0,0,0,10" Opacity="0.6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FPS" Style="{StaticResource Text.SectionLabel}" FontSize="9" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Monitoring.FpsText}" Style="{StaticResource Text.BodyStrong}" FontSize="12" />
                                <TextBlock Text="{Binding Monitoring.FpsDetail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="0,0,0,10" Opacity="0.6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FRAME TIME" Style="{StaticResource Text.SectionLabel}" FontSize="9" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Monitoring.FrameTimeText}" Style="{StaticResource Text.BodyStrong}" FontSize="12" />
                                <TextBlock Text="{Binding Monitoring.FrameTimeDetail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Panel.Card}" Padding="14,12" Opacity="0.6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU TEMP" Style="{StaticResource Text.SectionLabel}" FontSize="9" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Monitoring.CpuTemperatureText}" Style="{StaticResource Text.BodyStrong}" FontSize="12" />
                                <TextBlock Text="{Binding Monitoring.CpuTemperatureDetail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="Monitoring is read-only and local. FPS, frame pacing and CPU temperature need dedicated capture/sensor interfaces and are not inferred from other numbers."
                       Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap"
                       MaxWidth="860"
                       HorizontalAlignment="Left"
                       Margin="0,14,0,24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
