<UserControl x:Class="ValorantOptimizer.App.Views.DetailDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             mc:Ignorable="d">

    <Grid>
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDetailOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border Background="{StaticResource Scrim}" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" />

        <Border x:Name="DrawerPanel"
                Width="472"
                HorizontalAlignment="Right"
                Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1,0,0,0"
                Effect="{StaticResource Effect.DrawerShadow}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="48"
                                                         To="0"
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TranslateTransform X="0" />
            </Border.RenderTransform>

            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="22,18,14,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                CornerRadius="10"
                                Background="{Binding SelectedCard.CategorySoft}">
                            <Path Data="{Binding SelectedCard.CategoryIcon}"
                                  Stroke="{Binding SelectedCard.CategoryAccent}"
                                  StrokeThickness="1.5"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCard.CategoryLabel}"
                                       Style="{StaticResource Text.SectionLabel}"
                                       Margin="0,1,0,0" />
                            <TextBlock Text="OPTIMIZATION DETAILS"
                                       Style="{StaticResource Text.SectionLabel}"
                                       FontSize="9"
                                       Foreground="{StaticResource Text.Muted}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Close details" AutomationProperties.Name="Close details"
                                Command="{Binding CloseDetailsCommand}">
                            <Path Data="M7,7 L17,17 M17,7 L7,17"
                                  Stroke="{StaticResource Text.Secondary}"
                                  StrokeThickness="1.5"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding SelectedCard.Name}"
                               Style="{StaticResource Text.PageTitle}"
                               FontSize="19"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <Border Background="{Binding SelectedCard.StateSoft}"
                                BorderBrush="{Binding SelectedCard.StateBorder}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="9,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5"
                                         Fill="{Binding SelectedCard.StateForeground}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SelectedCard.StateLabel}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding SelectedCard.StateForeground}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SelectedCard.RiskLabel}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{Binding SelectedCard.RiskForeground}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <TextBlock Text="{Binding SelectedCard.MetaLabel}"
                                   Style="{StaticResource Text.Caption}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource Divider}" />

                <!-- Footer actions -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Background="{StaticResource Bg.Surface}"
                        Padding="22,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCard.BackupLabel}"
                                       Style="{StaticResource Text.Caption}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedCard.BusyText}"
                                       Style="{StaticResource Text.Caption}"
                                       FontSize="10"
                                       Foreground="{StaticResource State.Info}"
                                       Visibility="{Binding SelectedCard.ShowBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Close"
                                    Style="{StaticResource Button.Ghost}"
                                    FontSize="11.5"
                                    MinWidth="104"
                                    Height="32"
                                    Padding="10,6"
                                    Command="{Binding CloseDetailsCommand}" />
                            <Button Content="Undo change" AutomationProperties.Name="Undo change"
                                    Style="{StaticResource Button.Outline}"
                                    FontSize="11.5"
                                    MinWidth="104"
                                    Height="32"
                                    Padding="10,6"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding SelectedCard.ShowUndo, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding RequestUndoCommand}"
                                    CommandParameter="{Binding SelectedCard}" />
                            <Button Content="Apply change" AutomationProperties.Name="Apply change"
                                    Style="{StaticResource Button.Primary}"
                                    FontSize="11.5"
                                    MinWidth="104"
                                    Height="32"
                                    Padding="10,6"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding SelectedCard.ShowApply, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding RequestApplyCommand}"
                                    CommandParameter="{Binding SelectedCard}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Margin="22,18,22,26">

                        <!-- State -->
                        <Border Style="{StaticResource Panel.Tile}"
                                Background="{Binding SelectedCard.StateSoft}"
                                BorderBrush="{Binding SelectedCard.StateBorder}"
                                Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCard.Headline}"
                                           Style="{StaticResource Text.BodyStrong}"
                                           FontSize="12.5" />
                                <TextBlock Text="{Binding SelectedCard.Explanation}"
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding SelectedCard.HasExplanation, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding SelectedCard.Evidence}"
                                              Focusable="False"
                                              Margin="0,8,0,0"
                                              Visibility="{Binding SelectedCard.HasEvidence, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource Text.Caption}"
                                                           FontSize="10.5"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           Style="{StaticResource Text.Mono}"
                                                           FontSize="10.5"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SelectedCard.BlockedReason}"
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{StaticResource State.Warning}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding SelectedCard.HasBlockedReason, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- What it changes -->
                        <TextBlock Text="WHAT IT CHANGES"
                                   Style="{StaticResource Text.SectionLabel}"
                                   Margin="0,20,0,6" />
                        <TextBlock Text="{Binding SelectedCard.WhatItChanges}"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap" />

                        <!-- Why -->
                        <TextBlock Text="WHY IT MIGHT HELP"
                                   Style="{StaticResource Text.SectionLabel}"
                                   Margin="0,18,0,6" />
                        <TextBlock Text="{Binding SelectedCard.Why}"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap" />

                        <!-- Compatibility -->
                        <TextBlock Text="COMPATIBILITY"
                                   Style="{StaticResource Text.SectionLabel}"
                                   Margin="0,18,0,6" />
                        <TextBlock Text="{Binding SelectedCard.Compatibility}"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap" />

                        <!-- Notes -->
                        <StackPanel Visibility="{Binding SelectedCard.HasNotes, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="CAVEATS"
                                       Style="{StaticResource Text.SectionLabel}"
                                       Margin="0,18,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedCard.Notes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="•"
                                                       Foreground="{StaticResource Text.Muted}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding}"
                                                       Style="{StaticResource Text.Caption}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Original state -->
                        <TextBlock Text="YOUR ORIGINAL STATE"
                                   Style="{StaticResource Text.SectionLabel}"
                                   Margin="0,22,0,6" />
                        <Border Style="{StaticResource Panel.Tile}" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedCard.BackupLabel}"
                                               Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Text.Secondary}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedCard.BackupSourceLabel}"
                                               Style="{StaticResource Text.Caption}"
                                               FontSize="9.5" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SelectedCard.OriginalValues}"
                                              Focusable="False"
                                              Margin="0,7,0,0"
                                              Visibility="{Binding SelectedCard.HasOriginalValues, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource Text.Mono}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SelectedCard.OriginalStateNote}"
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding SelectedCard.HasOriginalStateNote, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- Managed locations -->
                        <StackPanel Visibility="{Binding SelectedCard.HasManagedLocations, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="MANAGED LOCATIONS"
                                       Style="{StaticResource Text.SectionLabel}"
                                       Margin="0,18,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedCard.ManagedLocations}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource Text.Mono}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="Changes are limited to the locations listed above. Anything outside them is rejected before it can be written."
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
