<UserControl x:Class="ValorantOptimizer.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="800"
             d:DesignWidth="1000"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="HistoryRowTemplate">
            <Border BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,0,1"
                    Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30"
                            CornerRadius="9"
                            Background="{Binding Soft}"
                            VerticalAlignment="Top"
                            Margin="0,1,14,0">
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{Binding Accent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActionLabel}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="·"
                                       Foreground="{StaticResource Text.Muted}"
                                       Margin="6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OptimizationName}"
                                       Style="{StaticResource Text.Body}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="430" />
                            <Border Background="{Binding Soft}"
                                    CornerRadius="20"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResultLabel}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Accent}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

                        <Border Background="{StaticResource Bg.Input}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="9,6"
                                Margin="0,7,0,0"
                                Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ChangesText}"
                                       Style="{StaticResource Text.Mono}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       MaxHeight="54" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding TimeLabel}"
                               Style="{StaticResource Text.Caption}"
                               FontSize="10.5"
                               HorizontalAlignment="Right"
                               Margin="18,2,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="0,0,8,0">

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageEyebrow}" Style="{StaticResource Text.SectionLabel}" />
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.PageTitle}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding PageSubtitle}"
                               Style="{StaticResource Text.Subtitle}"
                               TextWrapping="Wrap"
                               MaxWidth="760"
                               HorizontalAlignment="Left"
                               Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,4,0,0">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding RefreshHistoryCommand}" AutomationProperties.Name="Refresh history">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Outline}" Margin="10,0,0,0" Command="{Binding OpenLogFolderCommand}" AutomationProperties.Name="Open log folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Open log folder" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
                <TextBlock Text="{Binding HistorySummary}" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="Loading local history…"
                           Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Border Style="{StaticResource Panel.Tile}"
                    Background="{StaticResource State.DangerSoft}"
                    BorderBrush="{StaticResource State.DangerBorder}"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasHistoryError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding HistoryError}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource State.Danger}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Panel.Card}" Padding="0" Margin="0,0,0,20">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding HistoryEntries}"
                                  ItemTemplate="{StaticResource HistoryRowTemplate}"
                                  Focusable="False"
                                  Visibility="{Binding HasHistoryEntries, Converter={StaticResource BoolToVisibility}}" />
                    <Border Padding="28" Visibility="{Binding ShowHistoryEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="&#xE81C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{StaticResource Text.Muted}" />
                            <TextBlock Text="No actions recorded yet"
                                       Style="{StaticResource Text.BodyStrong}"
                                       FontSize="13.5"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="{Binding HistoryEmptyMessage}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="History is stored locally at %LOCALAPPDATA%\ValorantOptimizer\logs\actions.jsonl. Nothing is uploaded."
                       Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap"
                       MaxWidth="820"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
