<UserControl x:Class="ValorantOptimizer.App.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             mc:Ignorable="d">

    <Grid>
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConfirmOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border Background="{StaticResource Scrim}" />

        <Border x:Name="ConfirmCard"
                Width="536"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Bg.SurfaceRaised}"
                BorderBrush="{StaticResource Border.Strong}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                Effect="{StaticResource Effect.DrawerShadow}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConfirmOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="10"
                                                         To="0"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TranslateTransform Y="0" />
            </Border.RenderTransform>

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34"
                            CornerRadius="10"
                            Background="{StaticResource Accent.Soft}">
                        <Path Data="M12,3 L20,6.5 V12 C20,17 16.5,20.5 12,21.5 C7.5,20.5 4,17 4,12 V6.5 Z"
                              Stroke="{StaticResource Accent.Default}"
                              StrokeThickness="1.5"
                              Width="17"
                              Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ConfirmEyebrow}"
                               Style="{StaticResource Text.SectionLabel}"
                               VerticalAlignment="Center"
                               Margin="11,0,0,0" />
                    <Border Grid.Column="2"
                            BorderBrush="{Binding ConfirmRiskForeground}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="9,3"
                            VerticalAlignment="Center"
                            Visibility="{Binding ConfirmShowRisk, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ConfirmRiskLabel}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{Binding ConfirmRiskForeground}" />
                    </Border>
                </Grid>

                <TextBlock Text="{Binding ConfirmTitle}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}"
                           TextWrapping="Wrap"
                           LineHeight="25"
                           LineStackingStrategy="BlockLineHeight"
                           Margin="0,16,0,0" />

                <ScrollViewer MaxHeight="260"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Margin="0,9,0,0">
                    <TextBlock Text="{Binding ConfirmMessage}"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </ScrollViewer>

                <TextBlock Text="Windows will ask for administrator approval when you continue. The toolkit never keeps elevated rights."
                           Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource State.Warning}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding SelectedCard.RequiresElevation, Converter={StaticResource BoolToVisibility}}" />

                <Border Style="{StaticResource Divider}" Margin="0,16,0,14" />

                <CheckBox Style="{StaticResource CheckBox.Ack}"
                          IsChecked="{Binding ConfirmAcknowledged, Mode=TwoWay}"
                          Content="{Binding ConfirmAckText}"
                          Visibility="{Binding ConfirmRequireAck, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Cancel" AutomationProperties.Name="Cancel"
                            Style="{StaticResource Button.Secondary}"
                            Padding="16,8"
                            Command="{Binding CancelConfirmCommand}" />
                    <Button Content="{Binding ConfirmButtonText}" AutomationProperties.Name="Confirm"
                            Style="{StaticResource Button.Primary}"
                            Padding="16,8"
                            Margin="10,0,0,0"
                            IsEnabled="{Binding CanConfirm}"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
